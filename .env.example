# Runtime environment.
# Copy to .env for local development. Never commit the real file.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Google Cloud
GCP_PROJECT=pncp-pipeline-dev
BQ_LOCATION=US
GCS_BUCKET=pncp-pipeline-dev-lake

# PNCP API
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
PNCP_REQUEST_INTERVAL_SECONDS=1.25
PNCP_MAX_RETRIES=5
PNCP_PAGE_SIZE=50
PNCP_CONTRACT_PAGE_SIZE=500
PNCP_TIMEOUT_SECONDS=60
PNCP_MODALITIES=1,4,5,6,7,8,9,10,11,12

# Storage
GCS_PREFIX=bronze/pncp
BRONZE_DATASET=bronze
SILVER_DATASET=silver
AI_DATASET=ai
CONTROL_DATASET=control
LOCAL_DATA_DIR=data

# Vertex AI enrichment
VERTEX_LOCATION=global
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0
LLM_SAMPLE_RATE=0.1
LLM_INPUT_PRICE_PER_MILLION=0.25
LLM_OUTPUT_PRICE_PER_MILLION=1.50
LLM_PROMPT_VERSION=v1
LLM_TAXONOMY_VERSION=v1
LLM_BATCH_SIZE=20
LLM_MONTHLY_CAP=10000
LLM_MONTHLY_BUDGET_USD=10
